{
    "configurations": [
        {
            "name": "FastAPI local (uv)",
            "type": "debugpy",
            "request": "launch",
            
            "module": "uvicorn",

            "args": ["main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
            "cwd": "${workspaceFolder}/nllb-server",
            "env": {
                "PYTHONBUFFERED": "1",
                "MT_MODELS_STORAGE": "/opt/mt/models",
                "DEBUG": "1"
            },
            "justMyCode": false
        },
        {
            "name": "Attach NLLB Dev Container",
            "type": "debugpy",
            "request": "attach",

            "connect": {
                "host": "127.0.0.1",
                "port": 5678
            },

            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/nllb-server",
                    "remoteRoot": "/app"
                }
            ]

        }
    ]
}