{
  "tools": {
    "approvalMode": "default",
    "allowed": [
      "run_shell_command(python *)",
      "run_shell_command(uv *)",
      "run_shell_command(nvidia-smi)",
      "run_shell_command(git *)"
    ]
  },
  "mcpServers": {
    "context7": {
      "httpUrl": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-fb1763dd-7f51-437d-ad65-4bbfd9083ddf",
        "Accept": "application/json, text/event-stream"
      },
      "includeTools": ["query-docs"]
    },

    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "includeTools": ["sequentialthinking"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "includeTools": ["read_file", "search_files", "write_file"]
    },

    "git": {
      "command": "uvx",
      "args": ["mcp-server-git"],
      "includeTools": ["git_status", "git_diff", "git_log"]
    }
  },
  "$version": 4,
  "mcp": {
    "excluded": []
  }
}
